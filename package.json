  "devDependencies": {
    "@commitlint/cli": "^20.3.0",
    "@next/eslint-plugin-next": "^16.1.1",
    "@prisma/client": "^7.2.0",
    "@solvro/config": "^2.0.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.27",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prisma": "^7.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
